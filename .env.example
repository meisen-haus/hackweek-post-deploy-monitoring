# Copy to .env.local (gitignored) to point the demo at a local Sentry devserver.
#
#   cp .env.example .env.local
#
# Vite inlines these at build time and also reads them in `npm run dev`.

# --- Browser SDK -------------------------------------------------------------

# Copy verbatim from your local Sentry: Settings → Projects → <project> →
# Client Keys (DSN). Against a devserver it is http (not https) and points at
# the web port, e.g. http://a1b2c3d4e5f6...@localhost:8000/4
VITE_SENTRY_DSN=http://<public_key>@localhost:8000/<project_id>

# Release identifier. Must match whatever you register with Sentry so events,
# the release, and the deploy all line up. In CI this is the commit SHA.
VITE_RELEASE=local-dev

VITE_ENVIRONMENT=development

# The regression branch (feat/gate-change-highlights) parses this at startup.
# LEAVE IT UNSET to reproduce the page-load error the demo is about.
# Set it to make the branch behave:
# VITE_FEATURE_FLAGS={"gateHighlights":true,"countdownSeconds":8}

# Serve from / instead of /hackweek-post-deploy-monitoring/ locally.
# BASE_PATH=/

# --- Release + deploy registration (scripts/register-deploy.sh) --------------
#
# Registering the deploy is what makes Sentry fire its post-deploy webhook.

# Base URL of the Sentry install: trailing slash, no /api/0. Local devserver
# direct, or the ngrok host if you are tunnelling (see README) — in CI this is
# the SENTRY_URL repo variable.
SENTRY_URL=http://localhost:8000/
SENTRY_ORG=sentry
SENTRY_PROJECT=<project_slug>

# From http://localhost:8000/settings/account/api/auth-tokens/
# Needs project:releases (and org:read for set-commits --auto).
# sentry-cli reads this name; in CI it comes from the SENTRY_DEV_TOKEN secret.
SENTRY_AUTH_TOKEN=
