# Copy to .env.local (gitignored) to run the demo locally.
#
#   cp .env.example .env.local
#
# Vite inlines these at build time and also reads them in `npm run dev`.

# --- Browser SDK -------------------------------------------------------------

# Client Keys (DSN) for the Sentry project this branch reports to.
# Settings → Projects → <project> → Client Keys (DSN).
VITE_SENTRY_DSN=https://df43c498197c27d3cc649d36e923422f@o676634.ingest.us.sentry.io/4511933085188096

# Release identifier. Tags every event the bundle sends; nothing registers the
# release separately on this branch, so this value alone is what groups events
# by build. In CI it is <commit sha>+<run number>.
VITE_RELEASE=local-dev

VITE_ENVIRONMENT=development

# The regression branch (feat/gate-change-highlights) parses this at startup.
# LEAVE IT UNSET to reproduce the page-load error the demo is about.
# Set it to make the branch behave:
# VITE_FEATURE_FLAGS={"gateHighlights":true,"countdownSeconds":8}

# Serve from / instead of /hackweek-post-deploy-monitoring/ locally.
# BASE_PATH=/
